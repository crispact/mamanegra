<div class="instargram_area owl-carousel section_padding_100_0 clearfix bottom margin-top-footer" id="portfolio">
    {% for item in slider %}
        <div class="instagram_gallery_item">
            <a href="/assets/img/slider-img/{{ item }}" data-toggle="lightbox">
                <img src="/assets/img/slider-img/{{ item }}" alt="slider-footer" loading="lazy">
                <div class="hover_overlay">
                    <div class="yummy-table">
                        <div class="yummy-table-cell">
                            <div class="follow-me text-center"></div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    {% endfor %}
</div>

<div class="social_icon_area clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="footer-social-area d-flex">
                    <div class="single-icon">
                        <a href="https://www.facebook.com/cotopaxicultural" target="_blank"><i class="fa fa-facebook" aria-hidden="true"></i><span>facebook</span></a>
                    </div>
                    <div class="single-icon">
                        <a href="https://twitter.com/turismocotopaxi" target="_blank"><i class="fa fa-twitter" aria-hidden="true"></i><span>Twitter</span></a>
                    </div>
                    <div class="single-icon">
                        <a href="https://myalbum.com/album/ru6bxotTofo3ww/?invite=41307ef0-3c5b-41cd-93cf-ec0fa2762c1f" target="_blank"><i class="fa fa-picture-o" aria-hidden="true"></i><span>Photo Album</span></a>
                    </div>
                    <div class="single-icon">
                        <a href="https://www.youtube.com/c/TurismoCotopaxi" target="_blank"><i class="fa fa-youtube-play" aria-hidden="true"></i><span>Youtube</span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="footer_area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="footer-content">
                    <div class="footer-logo-area text-center">
                        <a href="/" class="yummy-logo">la mama negra</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="copy_right_text text-center">
                    <p>Copyright &copy;2020 Derechos Reservados | Diseño Web por <a href="https://www.llactatec.com" target="_blank">llactatec</a></p>
                </div>
            </div>
        </div>
    </div>
</footer>